# ===========================================
# Job Application Agent — Environment Variables
# ===========================================
# Copy this file to .env and fill in your keys.

# --- LLM Provider Selection ---
# Options: gemini, openai, groq
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.1
# Optional: function_calling | json_schema | json_mode (blank = provider default).
# json_schema is the most reliable for models that support it (e.g. Groq openai/gpt-oss-*).
LLM_STRUCTURED_OUTPUT_METHOD=

# --- Google Gemini ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Tavily (Web Search) ---
TAVILY_API_KEY=

# --- Self-evaluation ---
# Documents scoring below the threshold are revised automatically, up to MAX_REVISIONS times.
# Each revision uses more LLM quota; 0 is a good choice on free tiers.
REVIEW_QUALITY_THRESHOLD=80
MAX_REVISIONS=1

# --- Email sending (optional) ---
# Only used for jobs that ask for applications by email, after you approve and confirm.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com,
#        SMTP_PASSWORD=<an App Password from https://myaccount.google.com/apppasswords>
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_USERNAME=apikey, SMTP_PASSWORD=<API key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=

# --- Documents ---
# a4 or letter
PDF_PAGE_SIZE=a4
MAX_RESUME_SIZE_MB=5

# --- Storage ---
FAISS_INDEX_PATH=data/faiss_index

# --- Logging ---
LOG_LEVEL=INFO
