# ===========================================
# Job Application Agent — Environment Variables
# ===========================================
# Copy this file to .env and fill in your keys.

# --- LLM Provider Selection ---
# Options: gemini, openai, groq
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.1

# --- Google Gemini ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Tavily (Web Search) ---
TAVILY_API_KEY=

# --- Email (Module 9) ---
SENDGRID_API_KEY=
SENDER_EMAIL=

# --- Storage ---
FAISS_INDEX_PATH=data/faiss_index

# --- Logging ---
LOG_LEVEL=INFO
